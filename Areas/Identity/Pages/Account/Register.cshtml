@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrarse";
}

<div class="container py-5" style="max-width:480px">
    <h1 class="h3 mb-4">Crear cuenta</h1>

    <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
            <div class="form-text">Mínimo 6 caracteres, con mayúscula, minúscula y número.</div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-aa w-100">Registrarme</button>
    </form>

    <p class="mt-3 text-center">
        ¿Ya tenés cuenta? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Iniciá sesión</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
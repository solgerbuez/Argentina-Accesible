@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="container py-5" style="max-width:480px">
    <h1 class="h3 mb-2">¿Olvidaste tu contraseña?</h1>
    <p class="text-muted mb-4">Ingresá tu correo y te enviamos un enlace para crear una nueva.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-aa w-100">Enviar enlace</button>
    </form>

    <p class="mt-3 text-center"><a asp-page="./Login">Volver a iniciar sesión</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
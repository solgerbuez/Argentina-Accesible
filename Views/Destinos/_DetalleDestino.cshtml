@model ArgentinaAccesible.ViewModels.DetalleDestinoViewModel
@{
    var d = Model.Destino;
    var uid = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var esAdmin = User.IsInRole("Administrador");
    var esUsuario = User.IsInRole("Usuario");
    var logueado = User.Identity?.IsAuthenticated ?? false;
}

<div class="modal-header">
    <h2 class="modal-title h4" id="modalDestinoTitulo">@d.Nombre</h2>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
</div>

<div class="modal-body">
   <img src="@(d.ImagenUrl ?? "/images/hero-bg.jpg")" alt="@d.Nombre" class="rounded mb-3 w-100" style="max-height:340px;object-fit:contain;background:#eef2f6" />

    <div class="mb-2">
        <span class="badge etiqueta-cat">@d.Categoria?.Nombre</span>
        <span class="badge etiqueta-prov">@d.Provincia?.Nombre</span>
    </div>

    <p>@d.Descripcion</p>

    @if (!string.IsNullOrWhiteSpace(d.Direccion))
    {
        <p class="text-muted"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> @d.Direccion</p>
    }

    @if (d.Caracteristicas.Any())
    {
        <div class="mb-3">
            @foreach (var c in d.Caracteristicas)
            {
                <span class="badge etiqueta-car me-1">
                    <i class="fas @c.Caracteristica?.Icono" aria-hidden="true"></i> @c.Caracteristica?.Nombre
                </span>
            }
        </div>
    }

    <hr />

    <h3 class="h5 d-flex flex-wrap align-items-center gap-2">
        Reseñas
        @if (Model.Promedio != null)
        {
            <span class="fw-normal text-muted">
                <i class="fa-solid fa-star estrella" aria-hidden="true"></i>
                @Model.Promedio.Value.ToString("0.0") de 5 (@Model.Resenas.Count)
            </span>
        }
    </h3>

    @if (!Model.Resenas.Any())
    {
        <p class="text-muted">Todavía no hay reseñas de este destino.</p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var r in Model.Resenas)
            {
                <li class="border rounded p-3 mb-2">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <strong>@((r.Usuario?.UserName ?? "Usuario").Split('@')[0])</strong>
                            <span class="text-muted small"> · @r.Fecha.ToString("dd/MM/yyyy")</span>
                            <div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= r.Puntaje ? "fa-solid" : "fa-regular") fa-star estrella" aria-hidden="true"></i>
                                }
                                <span class="visually-hidden">@r.Puntaje de 5 estrellas</span>
                            </div>
                        </div>
                        @if (r.UsuarioId == uid || esAdmin)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-resena"
                                    data-resena="@r.Id" data-destino="@d.Id">
                                Eliminar
                            </button>
                        }
                    </div>
                    <p class="mb-0 mt-2">@r.Comentario</p>
                </li>
            }
        </ul>
    }

    @if (esUsuario)
    {
        var mi = Model.MiResena;
        <h3 class="h6 mt-4">@(mi == null ? "Dejá tu reseña" : "Editá tu reseña")</h3>
        <form class="form-resena" data-destino="@d.Id" novalidate>
            <input type="hidden" name="DestinoId" value="@d.Id" />
            <div class="mb-2">
                <label for="puntaje-@d.Id" class="form-label">Puntaje</label>
                <select id="puntaje-@d.Id" name="Puntaje" class="form-select" required>
                    @for (int p = 5; p >= 1; p--)
                    {
                        <option value="@p" selected="@(mi?.Puntaje == p)">@p @(p == 1 ? "estrella" : "estrellas")</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label for="comentario-@d.Id" class="form-label">Comentario</label>
                <textarea id="comentario-@d.Id" name="Comentario" class="form-control" rows="3"
                          maxlength="500" required>@mi?.Comentario</textarea>
            </div>
            <div class="text-danger small errores-resena" role="alert"></div>
            <button type="submit" class="btn btn-aa mt-2">Guardar reseña</button>
        </form>
    }
    else if (!logueado)
    {
        <p class="mt-3">
            <a asp-area="Identity" asp-page="/Account/Login">Iniciá sesión</a> para dejar tu reseña.
        </p>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>
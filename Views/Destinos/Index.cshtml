@model List<ArgentinaAccesible.Models.Destino>
@{
    ViewData["Title"] = "Destinos";
    var busqueda = ViewData["Busqueda"] as string;
    var favoritos = ViewData["Favoritos"] as HashSet<int> ?? new HashSet<int>();
}

@Html.AntiForgeryToken()

<section class="banner-pagina text-center">
    <div class="container">
        <h1>Destinos accesibles</h1>
        <form method="get" class="buscador mx-auto mt-3">
            <div class="input-group">
                <input type="text" name="busqueda" value="@busqueda" class="form-control"
                       placeholder="Buscar por nombre, provincia o categoría" aria-label="Buscar destinos" />
                <button class="btn btn-aa-naranja" type="submit">
                    <i class="fas fa-search"></i><span class="visually-hidden">Buscar</span>
                </button>
            </div>
        </form>
    </div>
</section>

<div class="container my-5">
    @if (!Model.Any())
    {
        <p class="text-center text-muted">No se encontraron destinos.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var d in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <button type="button" class="btn btn-aa btn-sm mt-3 btn-detalle" data-destino="@d.Id">
                        Ver detalle y reseñas
                    </button>
                    <div class="card destino-card h-100">
                        <partial name="_BotonFavorito" model="(d.Id, favoritos.Contains(d.Id))" />
                        <img src="@(d.ImagenUrl ?? "/images/hero-bg.jpg")" class="card-img-top" alt="@d.Nombre" />
                        <div class="card-body">
                            <div class="mb-2">
                                <span class="badge etiqueta-cat">@d.Categoria?.Nombre</span>
                                <span class="badge etiqueta-prov">@d.Provincia?.Nombre</span>
                            </div>
                            <h2 class="h5">@d.Nombre</h2>
                            <p class="text-muted">@d.Descripcion</p>
                            @foreach (var c in d.Caracteristicas)
                            {
                                <span class="badge etiqueta-car me-1">
                                    <i class="fas @c.Caracteristica?.Icono" aria-hidden="true"></i> @c.Caracteristica?.Nombre
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
@{
    ViewData["Title"] = "Quiénes somos";
}

<section class="banner-pagina text-center">
    <div class="container">
        <h1>Quiénes somos</h1>
        <p class="lead mb-0">Un proyecto para que viajar por Argentina sea posible para todas las personas.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="valor-card h-100">
                    <div class="valor-icono"><i class="fas fa-bullseye" aria-hidden="true"></i></div>
                    <h2 class="h5">Misión</h2>
                    <p class="mb-0">Facilitar que todas las personas puedan planificar viajes por Argentina con información clara y confiable sobre la accesibilidad de cada lugar.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="valor-card v2 h-100">
                    <div class="valor-icono"><i class="fas fa-eye" aria-hidden="true"></i></div>
                    <h2 class="h5">Visión</h2>
                    <p class="mb-0">Ser la guía de referencia del turismo accesible en el país, para que viajar sin barreras sea lo habitual.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="valor-card v3 h-100">
                    <div class="valor-icono"><i class="fas fa-handshake" aria-hidden="true"></i></div>
                    <h2 class="h5">Valores</h2>
                    <p class="mb-0">Inclusión, autonomía, información verificada y respeto por la experiencia de cada viajero.</p>
                </div>
            </div>
        </div>
    </div>
</section>
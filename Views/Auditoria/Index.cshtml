@model List<ArgentinaAccesible.Models.RegistroAuditoria>
@{
    ViewData["Title"] = "Auditoría";
    var entidadElegida = ViewData["Entidad"] as string;
    var entidades = new[] { "Destino", "Guía", "Provincia", "Categoría", "Característica", "Testimonio", "Reseña" };
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h1 class="h2 mb-0">Auditoría</h1>
        <form method="get" class="d-flex gap-2">
            <select name="entidad" class="form-select" aria-label="Filtrar por entidad">
                <option value="">Todas las entidades</option>
                @foreach (var e in entidades)
                {
                    <option value="@e" selected="@(e == entidadElegida)">@e</option>
                }
            </select>
            <button type="submit" class="btn btn-aa">Filtrar</button>
        </form>
    </div>

    <p class="text-muted">
        Historial de las últimas 200 operaciones del sistema: qué usuario creó, modificó o eliminó cada registro, y cuándo.
    </p>

    @if (!Model.Any())
    {
        <p class="text-center text-muted my-5">Todavía no hay operaciones registradas.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Acción</th>
                        <th>Entidad</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@r.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@r.Usuario</td>
                            <td>
                                <span class="badge @(r.Accion == "Creó" ? "bg-success" : r.Accion == "Modificó" ? "bg-warning text-dark" : "bg-danger")">@r.Accion</span>
                            </td>
                            <td>@r.Entidad</td>
                            <td>@r.Detalle</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
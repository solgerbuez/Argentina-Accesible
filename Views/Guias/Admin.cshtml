@model IEnumerable<ArgentinaAccesible.Models.Guia>
@{
    ViewData["Title"] = "Administrar guías";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Administrar guías</h1>
        <a asp-action="Create" class="btn btn-aa"><i class="fa-solid fa-plus"></i> Nueva guía</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Creada por</th>
                    <th>Modificada por</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td>@g.Titulo</td>
                        <td>@g.CreadoPor<br /><small class="text-muted">@g.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td>
                            @if (g.FechaModificacion != null)
                            {
                                @g.ModificadoPor
                                <br /><small class="text-muted">@g.FechaModificacion?.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                            else
                            {

                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@g.ArchivoPdf" target="_blank" class="btn btn-sm btn-outline-secondary">Ver PDF</a>
                            <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@g.Id" method="post" class="d-inline form-eliminar">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
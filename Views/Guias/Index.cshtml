@model IEnumerable<ArgentinaAccesible.Models.Guia>
@{
    ViewData["Title"] = "Guías";
}

<div class="container py-5">
    <h1 class="mb-1">Guías de turismo accesible</h1>
    <p class="text-muted mb-4">Descargá las guías con información verificada para planificar tu viaje.</p>

    <div class="row g-4">
        @foreach (var g in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(g.ImagenUrl))
                    {
                        <img src="@g.ImagenUrl" class="card-img-top" alt="Portada de @g.Titulo" style="height:180px;object-fit:cover">
                    }
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">@g.Titulo</h2>
                        <div class="mt-auto d-flex gap-2">
                            <a href="@g.ArchivoPdf" target="_blank" rel="noopener" class="btn btn-aa btn-sm">
                                <i class="fa-solid fa-eye"></i> Ver guía
                            </a>
                            <a href="@g.ArchivoPdf" download class="btn btn-outline-secondary btn-sm">
                                <i class="fa-solid fa-download"></i> Descargar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@model IEnumerable<ArgentinaAccesible.Models.Testimonio>
@{
    ViewData["Title"] = "Testimonios";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Testimonios</h1>
        <a asp-action="Create" class="btn btn-aa"><i class="fa-solid fa-plus"></i> Nuevo testimonio</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Localidad</th>
                    <th>Texto</th>
                    <th>Creado por</th>
                    <th>Modificado por</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Nombre</td>
                        <td>@t.Localidad</td>
                        <td style="max-width:280px">@(t.Texto.Length > 90 ? t.Texto[..90] + "…" : t.Texto)</td>
                        <td>@t.CreadoPor<br /><small class="text-muted">@t.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td>
                            @if (t.FechaModificacion != null)
                            {
                                @t.ModificadoPor
                                <br /><small class="text-muted">@t.FechaModificacion?.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                            else
                            {

                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@t.Id" method="post" class="d-inline form-eliminar">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
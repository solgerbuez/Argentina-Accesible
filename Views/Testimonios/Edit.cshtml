@model ArgentinaAccesible.Models.Testimonio
@{
    ViewData["Title"] = "Editar testimonio";
}

<div class="container py-5" style="max-width:640px">
    <h1 class="h3 mb-4">Editar testimonio</h1>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_Campos" model="Model" />
        <button type="submit" class="btn btn-aa">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}